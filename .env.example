# Command Code Provider API (https://commandcode.ai)
# Create at https://commandcode.ai/settings, then paste here.
CUSTOM_LLM_API_KEY=your_commandcode_api_key_here

# Pexels for stock images (https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# Presenton backend.
# - Docker Compose (app runs in a container): http://presenton  (port 80)
# - App run on the host with `npm start`:     http://localhost:5001
PRESENTON_URL=http://presenton

# TTS provider. One of:
#   deepgram (recommended — hosted Aura voices, ~seconds per deck):
#     POST https://api.deepgram.com/v1/speak?model=<DEEPGRAM_VOICE>
#     Requires DEEPGRAM_API_KEY. Free $200 credit (console.deepgram.com).
#   openai (default if unset) — OpenAI-compatible schema:
#     TTS_URL=https://api.openai.com/v1/audio/speech, TTS_VOICE=nova, TTS_MODEL=tts-1
#   kokoro (self-hosted, OpenAI-compatible):
#     TTS_URL=http://tts:8880/v1/audio/speech, TTS_VOICE=af_heart, TTS_CONCURRENCY=4
#     (enable with: docker compose --profile kokoro up)
TTS_PROVIDER=deepgram
TTS_URL=https://api.openai.com/v1/audio/speech
TTS_VOICE=nova
TTS_MODEL=tts-1
# Parallel TTS requests while generating voiceover. Deepgram handles ~8 fine;
# the local Kokoro CPU image tops out around 4.
TTS_CONCURRENCY=8

# Deepgram Aura TTS (used when TTS_PROVIDER=deepgram). Key from
# https://console.deepgram.com (projects -> API Keys). Voice is an Aura-2
# model id like aura-2-thalia-en (verify available models in your account).
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=aura-2-thalia-en

# Polishes slide text on-screen for proper capitalization and punctuation. See SLIDES_REWRITE=1.
# NARRATION_REWRITE=0

# Polish the on-screen slide text via the LLM: fix capitalization, punctuation,
# Rewrite the AI-generated speaker notes into direct student-facing narration
# before sending to TTS. Uses the same Command Code LLM (CUSTOM_MODEL).
# Off by default because it's an extra LLM call (~5-15s, ~$0.001/deck).
NARRATION_REWRITE=0

# Polish the on-screen slide text via the LLM: fix capitalization, punctuation,
# and missing spaces (e.g. "authorizationintent" -> "Authorization Intent"),
# and expand very short bullets. Doesn't change positions or images.
# SLIDES_REWRITE=0

# Pixel-perfect slide viewer: render each slide as a PNG via headless LibreOffice
# instead of compositing text+images from PPTX parsing. Requires:
#   npm run build:renderer    (one-time, builds ~800MB Docker image)
# Set USE_RENDERER=0 to force the text-composited fallback.
# USE_RENDERER=1

# Presentation settings
PPT_TEMPLATE=general
PPT_SLIDES=10
PPT_TONE=educational
PPT_LANGUAGE=English
PPT_VERBOSITY=standard
PPT_INCLUDE_TITLE=true
PPT_INCLUDE_TOC=false

# This app
PORT=3005

# Optional bearer token required on /api/upload and /api/embed.
# Set to any string (e.g. a long random value) to enable auth:
#   curl -H "Authorization: Bearer <token>" ...
# Leave empty to disable auth (dev only).
# API_TOKEN=

# Comma-separated list of origins allowed to call POST /api/embed.
# Defaults to '*' (any origin). Example:
#   EMBED_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.org
# EMBED_ALLOWED_ORIGINS=*
